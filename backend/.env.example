SECRET_KEY=replace-with-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional when Django Admin is served from a different origin.
CSRF_TRUSTED_ORIGINS=
POSTGRES_DB=medino
POSTGRES_USER=medino
POSTGRES_PASSWORD=replace-with-a-unique-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Match the frontend upload form's 50 MiB limit; adjust for deployment if needed.
MAX_UPLOAD_SIZE=52428800
# Local HTTP defaults. Set appropriate values behind a trusted HTTPS proxy in production.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
# Only when a trusted proxy sets and strips this header:
# SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
