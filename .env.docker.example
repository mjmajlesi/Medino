# Copy to .env.docker and replace both placeholders before starting Compose.
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
POSTGRES_DB=medino
POSTGRES_USER=medino
POSTGRES_PASSWORD=replace-with-a-unique-database-password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=
MAX_UPLOAD_SIZE=52428800

# The published port is loopback-only; put a TLS reverse proxy in front for production.
APP_BIND_HOST=127.0.0.1
APP_PORT=8080

# Local HTTP defaults. Enable HTTPS-only settings after TLS/proxy configuration.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https
